# =============================================================
# .gitignore — Gitに「これは記録しなくていいよ」と伝えるファイル
#
# ここに書いたファイルは、git add しても記録されなくなります。
# 詳しい説明： docs/06_safety.md
#
# 書き方のルール：
#   file.txt   → その名前のファイル
#   *.log      → .log で終わるファイル全部
#   dir/       → そのフォルダ以下すべて
#   # で始まる行 → コメント（無視される）
# =============================================================


# -------------------------------------------------------------
# 【最重要】秘密情報 — ここは絶対に消さないでください
# APIキーやパスワードが入るファイルです。
# 一度GitHubに上げると、後から消しても履歴に残り続けます。
# -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
service-account*.json


# -------------------------------------------------------------
# Node.js（JavaScript / TypeScript）
# node_modules は数万ファイル・数百MBになるので絶対に上げません。
# package.json があれば npm install で誰でも復元できます。
# -------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo


# -------------------------------------------------------------
# Python
# -------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.eggs/
htmlcov/
.coverage
.coverage.*


# -------------------------------------------------------------
# OS が勝手に作るファイル
# 中身は「フォルダの表示設定」などで、他人には全く不要です。
# これを上げると毎回PRに謎の差分が混ざります。
# -------------------------------------------------------------

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# -------------------------------------------------------------
# エディタ / IDE の設定ファイル
# 個人の好みの設定なので、チームで共有しません。
# -------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.\#*
\#*\#


# -------------------------------------------------------------
# その他
# -------------------------------------------------------------
*.log
tmp/
temp/
.cache/
